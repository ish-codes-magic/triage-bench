# Copy to .env (gitignored) and fill in only what you use. Never commit real keys.

# Model access. We route every model through OpenRouter (ADR-0010), so this is the only
# model key you need. LiteLLM reads it directly.
OPENROUTER_API_KEY=

# Direct provider keys: only needed if a config uses a non-openrouter/ model string.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# GitHub data collection (M1). A fine-grained token with public-repo read access is enough.
GITHUB_TOKEN=

# TypeSafe AI's Jev decision backend (M7), if you have early access.
TYPESAFE_API_KEY=
