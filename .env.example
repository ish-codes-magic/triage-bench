# Copy to .env (gitignored) and fill in only what you use. Never commit real keys.

# Model providers (LiteLLM reads these directly). You need the one for your configured model.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# GitHub data collection (M1). A fine-grained token with public-repo read access is enough.
GITHUB_TOKEN=

# TypeSafe AI's Jev decision backend (M7), if you have early access.
TYPESAFE_API_KEY=
